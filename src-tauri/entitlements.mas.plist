<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac App Store. Dateien: nur was per Dialog gewählt oder ins Fenster gezogen wird.
  network.client: WebKit braucht es in der Sandbox, um die eigenen, mitgelieferten Seiten
  zu zeigen (Befund aus ResearchTranscript, docs/PLAN-APPSTORE.md); die App öffnet selbst
  keine Verbindung. Kein Mikrofon: die App spielt nur ab.
-->
<plist version="1.0">
<dict>
  <key>com.apple.security.app-sandbox</key>
  <true/>
  <key>com.apple.application-identifier</key>
  <string>CCRJ4A42D3.city.bias.prepareaudio</string>
  <key>com.apple.developer.team-identifier</key>
  <string>CCRJ4A42D3</string>
  <key>com.apple.security.files.user-selected.read-write</key>
  <true/>
  <key>com.apple.security.network.client</key>
  <true/>
</dict>
</plist>
